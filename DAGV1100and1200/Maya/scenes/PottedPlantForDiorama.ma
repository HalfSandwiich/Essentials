connectAttr "polyTweak4.out" "polyBevel4.ip";
connectAttr "potShape.wm" "polyBevel4.mp";
connectAttr "polyBevel3.out" "polyTweak4.ip";
connectAttr "layerManager.dli[1]" "pot_.id";
