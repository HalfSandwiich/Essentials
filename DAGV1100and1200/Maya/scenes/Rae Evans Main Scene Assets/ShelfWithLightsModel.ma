	setAttr ".vn" -type "string" "ACES 1.0 SDR-video";
	setAttr ".dn" -type "string" "sRGB";
	setAttr ".wsn" -type "string" "ACEScg";
	setAttr ".otn" -type "string" "ACES 1.0 SDR-video (sRGB)";
	setAttr ".potn" -type "string" "ACES 1.0 SDR-video (sRGB)";
select -ne :hardwareRenderGlobals;
	setAttr ".ctrs" 256;
	setAttr ".btrs" 512;
select -ne :ikSystem;
	setAttr -s 4 ".sol";
connectAttr "groupId52.id" "ShelfWithLightsShape.iog.og[0].gid";
connectAttr ":initialShadingGroup.mwc" "ShelfWithLightsShape.iog.og[0].gco";
connectAttr "groupId51.id" "ShelfWithLightsShape.ciog.cog[0].cgid";
connectAttr "ShelfWithLightsShape.ciog.cog[0]" ":initialShadingGroup.dsm" -na;
connectAttr "ShelfWithLightsShape.iog.og[0]" ":initialShadingGroup.dsm" -na;
connectAttr "groupId52.msg" ":initialShadingGroup.gn" -na;
// End of ShelfWithLightsModel.ma
